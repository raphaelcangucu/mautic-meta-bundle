<div class="meta-head"><div><h2>{{ 'mautic.meta.ui.operations_547b9a'|trans }}</h2><p>{{ 'mautic.meta.ui.outbound_requests_events_and_results_acceptance_by_meta_does_not__98dc18'|trans }}</p></div></div>
<nav class="meta-nav" aria-label="{{ 'mautic.meta.ui.operation_type_22d702'|trans|e('html_attr') }}">{% for key,label in {jobs:('mautic.meta.ui.outbound_queue_8afc2f'|trans),events:('mautic.meta.ui.received_events_657152'|trans),messages:('mautic.meta.ui.messages_d3b297'|trans),deliveries:('mautic.meta.ui.external_integrations_4a0638'|trans)} %}<a class="{{ tab == key ? 'selected' : '' }}" href="{{ path('mautic_meta_operations',listQuery|merge({tab:key})) }}">{{ label }}</a>{% endfor %}</nav>
<form class="meta-filters" method="get"><input type="hidden" name="tab" value="{{ tab }}"><label>{{ 'mautic.meta.ui.status_2d3abf'|trans }}<select name="status" class="form-control"><option value="">{{ 'mautic.meta.ui.all_8a3c34'|trans }}</option>{% for s in ['queued','pending','retry','failed','completed','cancelled','received','processed','accepted','delivered','read'] %}<option value="{{ s }}" {{ app.request.query.get('status') == s ? 'selected' : '' }}>{{ {queued:('mautic.meta.ui.pending_or_retry_7da3e0'|trans),pending:('mautic.meta.ui.pending_87d9a8'|trans),retry:('mautic.meta.ui.retry_277495'|trans),failed:('mautic.meta.ui.failed_a183ed'|trans),completed:('mautic.meta.ui.completed_dbeb4d'|trans),cancelled:('mautic.meta.ui.cancelled_519684'|trans),received:('mautic.meta.ui.received_58c3c5'|trans),processed:('mautic.meta.ui.processed_44456c'|trans),accepted:('mautic.meta.ui.accepted_by_meta_5f8a9c'|trans),delivered:('mautic.meta.ui.delivered_e0ca94'|trans),read:('mautic.meta.ui.read_1c79a9'|trans)}[s] }}</option>{% endfor %}</select></label>
{% if tab in ['jobs','messages'] %}<label>{{ 'mautic.meta.ui.account_4d0751'|trans }}<select name="asset" class="form-control"><option value="">{{ 'mautic.meta.ui.all_8a3c34'|trans }}</option>{% for a in allAssets %}<option value="{{ a.id }}" {{ app.request.query.get('asset') == a.id ? 'selected' : '' }}>{{ a.name }}</option>{% endfor %}</select></label><label>{{ 'mautic.meta.ui.channel_61f21e'|trans }}<select name="channel" class="form-control"><option value="">{{ 'mautic.meta.ui.all_a4114a'|trans }}</option>{% for c in ['whatsapp','instagram','facebook'] %}<option value="{{ c }}" {{ app.request.query.get('channel') == c ? 'selected' : '' }}>{{ c|title }}</option>{% endfor %}</select></label><label>{{ 'mautic.meta.ui.operation_05b440'|trans }}<input class="form-control" name="operation" value="{{ app.request.query.get('operation') }}" placeholder="{{ 'mautic.meta.ui.e_g_whatsapp_text_b0c48a'|trans|e('html_attr') }}"></label>{% endif %}
<label>{{ 'mautic.meta.ui.from_966c7c'|trans }}<input class="form-control" type="date" name="from" value="{{ app.request.query.get('from') }}"></label><label>{{ 'mautic.meta.ui.until_fc4548'|trans }}<input class="form-control" type="date" name="to" value="{{ app.request.query.get('to') }}"></label>{{ include('@MauticMeta/Shared/limit.html.twig') }}</form>{{ include('@MauticMeta/Shared/filter_state.html.twig') }}
<div>
{% if tab == 'deliveries' %}<div class="panel panel-default"><div class="panel-heading"><strong>{{ 'mautic.meta.ui.external_integrations_4a0638'|trans }}</strong> <span class="text-muted">{{ 'mautic.meta.ui.filtered_results_4700a3'|trans }}</span></div><div class="table-responsive"><table class="table table-hover meta-operations-table"><thead><tr><th>ID</th><th>{{ 'mautic.meta.ui.date_e5e429'|trans }}</th><th>{{ 'mautic.meta.ui.adapter_d712e6'|trans }}</th><th>{{ 'mautic.meta.ui.event_9383be'|trans }}</th><th>{{ 'mautic.meta.ui.status_2d3abf'|trans }}</th><th>{{ 'mautic.meta.ui.attempts_b717db'|trans }}</th><th>{{ 'mautic.meta.ui.details_6dd94e'|trans }}</th><th></th></tr></thead><tbody>
{% for delivery in listing.items %}<tr><td>{{ delivery.id }}</td><td>{{ delivery.dateAdded|date('mautic.meta.ui.date_time_format'|trans) }}</td><td>{{ delivery.adapterName }}</td><td>{{ delivery.eventName }}</td><td>{{ include('@MauticMeta/Shared/status.html.twig', {status:delivery.status}) }}</td><td>{{ delivery.attempts }}/{{ delivery.maxAttempts }}</td><td><small>{{ include('@MauticMeta/Shared/error.html.twig', {error:delivery.lastError}) }}</small></td><td>{% if delivery.status == 'failed' %}<form method="post" action="{{ path('mautic_meta_adapter_retry', {deliveryId: delivery.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('meta_adapter_retry_' ~ delivery.id) }}"><button class="btn btn-primary btn-xs">{{ 'mautic.meta.ui.review_retry_3a32b3'|trans }}</button></form>{% endif %}</td></tr>
{% else %}<tr><td colspan="8" class="text-muted text-center">{{ 'mautic.meta.ui.no_external_deliveries_found_2e348e'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>{{ include('@MauticMeta/Shared/pagination.html.twig') }}{% endif %}
{% if tab == 'jobs' %}<div class="panel panel-default"><div class="panel-heading"><strong>{{ 'mautic.meta.ui.outbound_queue_8afc2f'|trans }}</strong> <span class="text-muted">{{ 'mautic.meta.ui.filtered_results_4700a3'|trans }}</span></div><div class="table-responsive"><table class="table table-hover meta-operations-table"><thead><tr><th>ID</th><th>{{ 'mautic.meta.ui.date_e5e429'|trans }}</th><th>{{ 'mautic.meta.ui.account_4d0751'|trans }}</th><th>{{ 'mautic.meta.ui.operation_05b440'|trans }}</th><th>{{ 'mautic.meta.ui.status_2d3abf'|trans }}</th><th>{{ 'mautic.meta.ui.attempts_b717db'|trans }}</th><th>{{ 'mautic.meta.ui.details_6dd94e'|trans }}</th><th></th></tr></thead><tbody>
{% for job in listing.items %}<tr><td>{{ job.id }}</td><td>{{ job.dateAdded|date('mautic.meta.ui.date_time_format'|trans) }}</td><td>{{ job.asset.name }}<div class="meta-cell-secondary">{{ include('@MauticMeta/Shared/channel.html.twig', {channel:job.asset.type.value}) }}</div></td><td>{{ {facebook_direct_message:('mautic.meta.ui.messenger_message_d6d263'|trans),facebook_public_reply:('mautic.meta.ui.facebook_public_reply_32895c'|trans),instagram_direct_message:('mautic.meta.ui.instagram_message_954dd4'|trans),instagram_private_reply:('mautic.meta.ui.instagram_private_reply_d08168'|trans),whatsapp_text:('mautic.meta.ui.whatsapp_text_eb7b4c'|trans),whatsapp_template:('mautic.meta.ui.whatsapp_template_fd76e5'|trans)}[job.operation]|default(job.operation) }}</td><td>{{ include('@MauticMeta/Shared/status.html.twig', {status:job.status}) }}</td><td>{{ job.attempts }}/{{ job.maxAttempts }}</td><td><small>{{ include('@MauticMeta/Shared/error.html.twig', {error:job.lastError}) }}</small></td><td>
{% if job.status in ['failed', 'cancelled'] %}<form onsubmit="return confirm({{ ('mautic.meta.ui.have_you_reviewed_the_failure_and_confirmed_that_the_message_was__30fa76'|trans)|json_encode|e('html_attr') }});" class="d-inline" method="post" action="{{ path('mautic_meta_job_retry', {jobId: job.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('meta_job_retry_' ~ job.id) }}"><button class="btn btn-primary btn-xs">{{ 'mautic.meta.ui.review_retry_3a32b3'|trans }}</button></form>{% endif %}
{% if job.status in ['pending', 'retry'] %}<form class="d-inline" method="post" action="{{ path('mautic_meta_job_cancel', {jobId: job.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('meta_job_cancel_' ~ job.id) }}"><button class="btn btn-warning btn-xs">{{ 'mautic.meta.ui.cancel_c111e0'|trans }}</button></form>{% endif %}</td></tr>
{% else %}<tr><td colspan="8" class="text-muted text-center">{{ 'mautic.meta.ui.no_outbound_requests_found_9d9821'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>{{ include('@MauticMeta/Shared/pagination.html.twig') }}{% endif %}

{% if tab == 'events' %}<div class="panel panel-default"><div class="panel-heading"><strong>{{ 'mautic.meta.ui.received_events_657152'|trans }}</strong> <span class="text-muted">{{ 'mautic.meta.ui.filtered_results_4700a3'|trans }}</span></div><div class="table-responsive"><table class="table table-hover meta-operations-table"><thead><tr><th>ID</th><th>{{ 'mautic.meta.ui.received_at_ff3b7f'|trans }}</th><th>{{ 'mautic.meta.ui.connection_ef46fe'|trans }}</th><th>{{ 'mautic.meta.ui.source_8adfd7'|trans }}</th><th>{{ 'mautic.meta.ui.status_2d3abf'|trans }}</th><th>{{ 'mautic.meta.ui.attempts_b717db'|trans }}</th><th>{{ 'mautic.meta.ui.details_6dd94e'|trans }}</th><th></th></tr></thead><tbody>
{% for event in listing.items %}<tr><td>{{ event.id }}</td><td>{{ event.receivedAt|date('mautic.meta.ui.date_time_format'|trans) }}</td><td>{{ event.connection.name }}</td><td>{{ include('@MauticMeta/Shared/channel.html.twig', {channel:event.objectType}) }}</td><td>{{ include('@MauticMeta/Shared/status.html.twig', {status:event.status}) }}</td><td>{{ event.attempts }}</td><td><small>{{ include('@MauticMeta/Shared/error.html.twig', {error:event.lastError}) }}</small></td><td>{% if event.status == 'failed' %}<form method="post" action="{{ path('mautic_meta_webhook_replay', {eventId: event.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('meta_webhook_replay_' ~ event.id) }}"><button class="btn btn-primary btn-xs">{{ 'mautic.meta.ui.reprocess_686f47'|trans }}</button></form>{% endif %}</td></tr>
{% else %}<tr><td colspan="8" class="text-muted text-center">{{ 'mautic.meta.ui.no_events_found_41330c'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>{{ include('@MauticMeta/Shared/pagination.html.twig') }}{% endif %}

{% if tab == 'messages' %}<div class="panel panel-default"><div class="panel-heading"><strong>{{ 'mautic.meta.ui.message_history_c3a529'|trans }}</strong> <span class="text-muted">{{ 'mautic.meta.ui.filtered_results_4700a3'|trans }}</span></div><div class="table-responsive"><table class="table table-hover meta-operations-table"><thead><tr><th>ID</th><th>{{ 'mautic.meta.ui.date_e5e429'|trans }}</th><th>{{ 'mautic.meta.ui.channel_61f21e'|trans }}</th><th>{{ 'mautic.meta.ui.direction_5f7970'|trans }}</th><th>{{ 'mautic.meta.ui.account_4d0751'|trans }}</th><th>{{ 'mautic.meta.ui.recipient_1df205'|trans }}</th><th>{{ 'mautic.meta.ui.type_6cc619'|trans }}</th><th>{{ 'mautic.meta.ui.status_2d3abf'|trans }}</th><th>{{ 'mautic.meta.ui.details_6dd94e'|trans }}</th></tr></thead><tbody>
{% for message in listing.items %}<tr><td>{{ message.id }}</td><td>{{ message.dateAdded|date('mautic.meta.ui.date_time_format'|trans) }}</td><td>{{ include('@MauticMeta/Shared/channel.html.twig', {channel:message.channel}) }}</td><td><span class="meta-direction"><i class="{{ message.direction == 'inbound' ? 'ri-arrow-left-down-line' : 'ri-arrow-right-up-line' }}" aria-hidden="true"></i>{{ message.direction == 'inbound' ? ('mautic.meta.ui.received_c1b6fe'|trans) : ('mautic.meta.ui.sent_e1be83'|trans) }}</span></td><td>{{ message.asset.name }}</td><td class="meta-identifier">{{ message.recipient }}</td><td>{{ include('@MauticMeta/Shared/message_type.html.twig', {type:message.messageType}) }}</td><td>{{ include('@MauticMeta/Shared/status.html.twig', {status:message.status}) }}</td><td><small>{{ include('@MauticMeta/Shared/error.html.twig', {error:message.error}) }}</small></td></tr>
{% else %}<tr><td colspan="9" class="text-muted text-center">{{ 'mautic.meta.ui.no_messages_found_5e592d'|trans }}</td></tr>{% endfor %}</tbody></table></div></div>{{ include('@MauticMeta/Shared/pagination.html.twig') }}{% endif %}
</div>
{% endblock %}
