{% set message = event.extra.message %}
<dl class="dl-horizontal">
    <dt>{{ 'mautic.core.type'|trans }}</dt><dd>{{ message.messageType }}</dd>
    <dt>Status</dt><dd>{{ message.status }}</dd>
    <dt>{{ 'mautic.meta.direction'|trans }}</dt><dd>{{ message.direction }}</dd>
    <dt>{{ 'mautic.meta.recipient'|trans }}</dt><dd>{{ message.recipient }}</dd>
    {% if message.externalId %}<dt>Meta ID</dt><dd>{{ message.externalId }}</dd>{% endif %}
    {% if message.error %}<dt>{{ 'mautic.core.error'|trans }}</dt><dd>{{ message.error }}</dd>{% endif %}
</dl>
