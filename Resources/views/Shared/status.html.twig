{% set key = status|default('unknown')|lower %}
{% set labels = {active:('mautic.meta.ui.active_in_configuration_8ddf36'|trans),inactive:('mautic.meta.ui.inactive_01cbc3'|trans),error:('mautic.meta.ui.error_8dba36'|trans),pending:('mautic.meta.ui.pending_87d9a8'|trans),queued:('mautic.meta.ui.queued_a3ecf1'|trans),retry:('mautic.meta.ui.retry_277495'|trans),failed:('mautic.meta.ui.failed_a183ed'|trans),completed:('mautic.meta.ui.completed_dbeb4d'|trans),cancelled:('mautic.meta.ui.cancelled_519684'|trans),received:('mautic.meta.ui.received_58c3c5'|trans),processed:('mautic.meta.ui.processed_44456c'|trans),accepted:('mautic.meta.ui.accepted_by_meta_5f8a9c'|trans),delivered:('mautic.meta.ui.delivered_e0ca94'|trans),read:('mautic.meta.ui.read_1c79a9'|trans),sent:('mautic.meta.ui.sent_8fd437'|trans),approved:('mautic.meta.ui.approved_74eebf'|trans),rejected:('mautic.meta.ui.rejected_3b2d4f'|trans),paused:('mautic.meta.ui.paused_7f7e6f'|trans),disabled:('mautic.meta.ui.disabled_8809a6'|trans),unknown:('mautic.meta.ui.not_provided_0cd27e'|trans)} %}
{% set tone = key in ['failed','error','rejected'] ? 'danger' : (key in ['active','completed','processed','delivered','approved'] ? 'success' : (key in ['pending','queued','retry','paused'] ? 'warning' : (key in ['received','accepted','read','sent'] ? 'info' : 'neutral'))) %}
{% set icon = tone == 'danger' ? 'ri-error-warning-line' : (tone == 'success' ? 'ri-checkbox-circle-line' : (tone == 'warning' ? 'ri-time-line' : (key == 'read' ? 'ri-check-double-line' : 'ri-information-line'))) %}
<span class="meta-chip meta-chip-{{ tone }}"><i class="{{ icon }}" aria-hidden="true"></i>{{ labels[key]|default(status) }}</span>
