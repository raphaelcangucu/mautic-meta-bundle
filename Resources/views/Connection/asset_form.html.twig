{% extends '@MauticMeta/Shared/layout.html.twig' %}
{% block headerTitle %}{{ asset is defined ? ('mautic.meta.ui.manage_account_d1a147'|trans) : ('mautic.meta.ui.add_account_b96eb4'|trans) }}{% endblock %}
{% block metaBody %}
{% if asset is defined and asset.type.value == 'whatsapp_phone_number' %}{{ includeStylesheet('plugins/MauticMetaBundle/Assets/css/tech-provider.css?v=20260914-2') }}{% endif %}
<div class="meta-head"><div><h2>{{ asset is defined ? asset.name : ('mautic.meta.ui.add_account_b96eb4'|trans) }}</h2><p>{{ connection.name }}</p></div><a class="btn btn-default" data-meta-back href="{{ path('mautic_meta_connections') }}">{{ 'mautic.meta.ui.back_to_accounts_2d4cea'|trans }}</a></div>

{% if asset is defined and asset.type.value == 'whatsapp_phone_number' and app.user and app.user.isAdmin() %}
{% set readiness = asset.settings.provider_readiness|default({}) %}
<section class="tp-diagnostic" aria-label="Diagnóstico do WhatsApp">
  <div class="tp-diagnostic-head"><div><span class="tp-eyebrow">WHATSAPP CLOUD API</span><h3>Diagnóstico do número</h3><p>{{ asset.phoneNumber|default('Número não informado') }} · ID Meta {{ asset.externalId }}</p></div><span class="tp-badge {{ readiness.ready|default(false) ? 'tp-good' : '' }}">{{ readiness.ready|default(false) ? 'API preparada' : 'API não confirmada' }}</span></div>
  <div class="tp-diagnostic-grid"><div><span>Status do número</span><strong>{{ readiness.phone_status|default('Não verificado') }}</strong></div><div><span>Posse</span><strong>{{ readiness.checked_at|default(false) ? (readiness.verified|default(false) ? 'Verificada' : 'Não confirmada') : 'Não verificada' }}</strong></div><div><span>Webhooks</span><strong>{{ readiness.checked_at|default(false) ? (readiness.subscribed|default(false) ? 'Assinados' : 'Não confirmados') : 'Não verificados' }}</strong></div><div><span>Entrega</span><strong>{{ readiness.delivery|default('not_tested') == 'not_tested' ? 'Não testada' : readiness.delivery }}</strong></div></div>
  {% if readiness.checked_at|default(false) %}<p class="tp-diagnostic-time">Última verificação: {{ readiness.checked_at }}</p>{% endif %}
  <div class="tp-diagnostic-actions"><form method="post" action="{{ path('mautic_meta_provider') }}"><input type="hidden" name="_token" value="{{ csrf_token('meta_provider') }}"><input type="hidden" name="asset" value="{{ asset.id }}"><input type="hidden" name="return_asset" value="{{ asset.id }}"><button class="btn btn-primary" name="action" value="check">Diagnosticar sem enviar</button><button class="btn btn-default" name="action" value="subscribe">Assinar webhooks</button><button class="btn btn-default" name="action" value="sync">Sincronizar templates</button></form></div>
  <p class="tp-diagnostic-help">A API preparada não confirma permissão por país, pagamento ou entrega. Consulte os jobs e status reais em <a href="{{ path('mautic_meta_operations') }}">Operações</a>.</p>
  <details class="tp-register"><summary>Registrar número novo na Cloud API</summary><p>Use apenas após confirmar a posse na Meta. Um número já conectado não será registrado novamente.</p><form method="post" action="{{ path('mautic_meta_provider') }}"><input type="hidden" name="_token" value="{{ csrf_token('meta_provider') }}"><input type="hidden" name="asset" value="{{ asset.id }}"><input type="hidden" name="return_asset" value="{{ asset.id }}"><label>PIN de duas etapas<input name="pin" type="password" class="form-control" autocomplete="off" inputmode="numeric" maxlength="6" pattern="[0-9]{6}"></label><button class="btn btn-default" name="action" value="register">Registrar</button></form></details>
  <details class="tp-register"><summary>Enviar um teste controlado</summary><p>Requer consentimento registrado para este número remetente. Uma única tentativa, sem reenvio automático.</p><form method="post" action="{{ path('mautic_meta_provider') }}" class="tp-test-form"><input type="hidden" name="_token" value="{{ csrf_token('meta_provider') }}"><input type="hidden" name="asset" value="{{ asset.id }}"><input type="hidden" name="return_asset" value="{{ asset.id }}"><input type="hidden" name="attempt" value="{{ attempt }}"><input type="hidden" name="action" value="test"><label>Template aprovado<select name="template" required class="form-control"><option value="">Selecione</option>{% for template in templates %}{% if template.businessAccount.connection.id == asset.connection.id and template.businessAccount.externalId == asset.settings.waba_id|default('') %}<option value="{{ template.id }}">{{ template.name }} · {{ template.language }}</option>{% endif %}{% endfor %}</select></label><label>Destinatário com DDI<input name="recipient" required class="form-control" placeholder="+55…"></label><label>Componentes de parâmetros (JSON)<textarea name="components" class="form-control">[]</textarea></label><label class="tp-test-confirm"><input type="checkbox" name="confirm" value="1" required> Confirmo este envio de teste ao destinatário indicado.</label><button class="btn btn-primary">Enviar uma vez</button></form></details>
</section>
{% endif %}

{% if asset is defined and asset.type.value == 'whatsapp_phone_number' and businessProfileForm %}
<section class="wa-profile" aria-labelledby="wa-profile-title">
  <div class="wa-profile-head">
    <div class="wa-profile-identity">
      {% if businessProfile.profile_picture_url|default('') starts with 'https://' %}<img src="{{ businessProfile.profile_picture_url }}" alt="Foto atual do perfil do WhatsApp">{% else %}<span class="wa-profile-placeholder" aria-hidden="true">WA</span>{% endif %}
      <div><span class="tp-eyebrow">PERFIL PÚBLICO</span><h3 id="wa-profile-title">Perfil exibido no WhatsApp</h3><p>{{ asset.phoneNumber|default('Número não informado') }}</p></div>
    </div>
    <div class="wa-display-name"><span>Nome de exibição aprovado</span><strong>{{ businessProfile.verified_name|default('Não foi possível consultar') }}</strong></div>
  </div>
  <div class="wa-name-note"><div><strong>O nome de exibição não é alterado pela Cloud API.</strong><p>Ele depende da análise da Meta. Solicite a mudança no WhatsApp Manager; o campo “Nome” mais abaixo é somente a identificação interna no Mautic.</p></div><a class="btn btn-default" href="https://business.facebook.com/wa/manage/phone-numbers/" target="_blank" rel="noopener noreferrer">Abrir WhatsApp Manager</a></div>
  {% if businessProfileError %}<div class="alert alert-warning"><strong>Não foi possível carregar o perfil atual da Meta.</strong> {{ businessProfileError }} Você ainda pode preencher os campos e tentar salvar.</div>{% endif %}
  {{ form_start(businessProfileForm, {action:path('mautic_meta_asset_edit',{assetId:asset.id}), method:'POST', attr:{class:'wa-profile-form'}}) }}
  {{ form_errors(businessProfileForm) }}
  <div class="wa-profile-fields"><div class="wa-picture-field">{{ form_row(businessProfileForm.profile_picture) }}</div>{{ form_row(businessProfileForm.about) }}{{ form_row(businessProfileForm.description) }}{{ form_row(businessProfileForm.address) }}{{ form_row(businessProfileForm.email) }}{{ form_row(businessProfileForm.website_1) }}{{ form_row(businessProfileForm.website_2) }}{{ form_row(businessProfileForm.vertical) }}</div>
  <div class="wa-profile-actions"><p>Ao salvar, estes dados são enviados agora para o perfil público do número pela API oficial da Meta.</p><button class="btn btn-primary" type="submit">Salvar no WhatsApp</button></div>
  {{ form_end(businessProfileForm) }}
</section>
{% endif %}

{{ form_start(form, {attr:{class:'meta-form', 'data-meta-asset':''}}) }}{{ form_errors(form) }}
<div class="meta-split"><div class="meta-box meta-pad"><h3>{{ 'mautic.meta.ui.account_details_ed62c7'|trans }}</h3>{% if asset is defined and asset.type.value == 'whatsapp_phone_number' %}<p class="wa-local-name-note"><strong>Dados internos do Mautic.</strong> O nome deste cadastro não altera o nome de exibição no WhatsApp.</p>{% endif %}{{ form_row(form.name) }}{{ form_row(form.type) }}<div data-asset-only="instagram_account">{{ form_row(form.username) }}</div><div data-asset-only="whatsapp_phone_number">{{ form_row(form.phone_number) }}</div>{{ form_row(form.contact_match_field) }}{{ form_row(form.is_default) }}<details {{ asset is not defined ? 'open' : '' }}><summary>{{ 'mautic.meta.ui.technical_identifiers_e3eea0'|trans }}</summary>{{ form_row(form.external_id) }}</details></div><div class="meta-box meta-pad"><h3>{{ 'mautic.meta.ui.sending_limits_98dd8a'|trans }}</h3><p>{{ 'mautic.meta.ui.limits_configured_in_the_connector_meta_rules_and_messaging_windo_f16e4b'|trans }}</p>{{ form_row(form.daily_send_limit) }}{{ form_row(form.hourly_send_limit) }}{{ form_row(form.recipient_daily_limit) }}{{ form_row(form.recipient_cooldown_seconds) }}</div></div>
<div class="meta-box meta-pad" data-asset-only="whatsapp_phone_number"><h3>{{ 'mautic.meta.ui.whatsapp_phone_and_consent_5af464'|trans }}</h3><div class="meta-fields">{{ form_row(form.default_region) }}{{ form_row(form.trusted_import_default_region) }}</div>{{ form_row(form.trusted_import_convert_legacy_br_mobile) }}{{ form_row(form.require_opt_in) }}</div>
<div class="meta-actions"><button class="btn btn-primary" name="submit" value="1">{{ 'mautic.meta.ui.save_changes_3bbd53'|trans }}</button><a class="btn btn-default" data-meta-back href="{{ path('mautic_meta_connections') }}">{{ 'mautic.meta.ui.cancel_c111e0'|trans }}</a></div>{{ form_end(form) }}
{% if asset is defined %}<details><summary>{{ 'mautic.meta.ui.remove_account_e88f2d'|trans }}</summary><form method="post" action="{{ path('mautic_meta_asset_delete',{assetId:asset.id}) }}" onsubmit="return confirm({{ ('mautic.meta.ui.delete_this_account_and_its_message_history_6223da'|trans)|json_encode|e('html_attr') }});"><input type="hidden" name="_token" value="{{ csrf_token('meta_asset_delete_'~asset.id) }}"><button class="btn btn-danger">{{ 'mautic.meta.ui.delete_account_752ea7'|trans }}</button></form></details>{% endif %}
{% endblock %}
