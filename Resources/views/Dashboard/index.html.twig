{% extends '@MauticMeta/Shared/layout.html.twig' %}{% block headerTitle %}{{ 'mautic.meta.ui.meta_overview_0d2564'|trans }}{% endblock %}{% block metaBody %}<div class="meta-head"><div><h2>{{ 'mautic.meta.ui.your_channels_in_one_place_4c02bd'|trans }}</h2><p>{{ 'mautic.meta.ui.connections_messages_and_items_needing_attention_baea22'|trans }}</p></div><a class="btn btn-default" href="{{ path('mautic_meta_connections') }}">{{ 'mautic.meta.ui.manage_accounts_d7b2a3'|trans }}</a></div>
<form method="get" class="meta-filters"><label>{{ 'mautic.meta.ui.account_4d0751'|trans }}<select class="form-control" name="asset"><option value="">{{ 'mautic.meta.ui.all_8a3c34'|trans }}</option>{% for a in allAssets %}<option value="{{ a.id }}" {{ app.request.query.get('asset') == a.id ? 'selected' : '' }}>{{ a.name }}</option>{% endfor %}</select></label><label>{{ 'mautic.meta.ui.creation_period_c98352'|trans }}<select class="form-control" name="period">{% for value,label in {all:('mautic.meta.ui.all_history_5726e7'|trans),'7':('mautic.meta.ui.last_7_days_0c7f53'|trans),'30':('mautic.meta.ui.last_30_days_ae8ad7'|trans)} %}<option value="{{ value }}" {{ app.request.query.get('period','all') == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><button class="btn btn-primary">{{ 'mautic.meta.ui.filter_d878f8'|trans }}</button><a class="btn btn-default" href="{{ path('mautic_meta_dashboard') }}">{{ 'mautic.meta.ui.clear_filters_d22f68'|trans }}</a></form>
{% set opFilters = app.request.query.get('asset') ? {asset:app.request.query.get('asset')} : {} %}{% if app.request.query.get('period') in ['7','30'] %}{% set opFilters = opFilters|merge({from:('now'|date_modify('-'~app.request.query.get('period')~' days'))|date('Y-m-d')}) %}{% endif %}
<div class="meta-metrics"><div class="meta-metric">{{ 'mautic.meta.ui.messages_d3b297'|trans }}<strong>{{ messageCount }}</strong><small>{{ 'mautic.meta.ui.for_the_selected_period_and_account_2b2f31'|trans }}</small></div><a class="meta-metric" href="{{ path('mautic_meta_operations',opFilters|merge({tab:'jobs',status:'queued'})) }}">{{ 'mautic.meta.ui.pending_retry_queue_fe8eb8'|trans }}<strong>{{ queuePending }}</strong><small>{{ 'mautic.meta.ui.operations_created_in_the_selected_period_5b3816'|trans }}</small></a><a class="meta-metric" href="{{ path('mautic_meta_operations',opFilters|merge({tab:'jobs',status:'failed'})) }}">{{ 'mautic.meta.ui.recorded_failures_d37a16'|trans }}<strong>{{ queueFailed }}</strong><small>{{ 'mautic.meta.ui.filtered_history_review_causes_291d5e'|trans }}</small></a></div>
{% if queueFailed %}<div class="meta-notice"><strong>{{ 'mautic.meta.ui.there_are_failures_in_the_selected_history_7398e7'|trans }}</strong> {{ 'mautic.meta.ui.an_old_error_does_not_necessarily_reflect_the_channel_s_current_s_4ca2a5'|trans }} <a href="{{ path('mautic_meta_operations',opFilters|merge({tab:'jobs',status:'failed'})) }}">{{ 'mautic.meta.ui.review_failures_a61c71'|trans }}</a></div>{% endif %}
<div class="meta-box"><div class="meta-boxhead"><strong>{{ 'mautic.meta.ui.connected_accounts_77f3c4'|trans }}</strong><small>{{ 'mautic.meta.ui.all_configured_accounts_230d9e'|trans }} {{ connectionCount }} {{ 'mautic.meta.ui.connections_711c22'|trans }} {{ assetCount }} {{ 'mautic.meta.ui.accounts_and_assets_2f9962'|trans }}</small></div>{% for a in allAssets|slice(0,5) %}<div class="meta-row meta-account-row"><div class="meta-person"><span class="meta-avatar"><i class="{{ a.type.value == 'instagram_account' ? 'ri-instagram-line' : (a.type.value == 'facebook_page' ? 'ri-facebook-circle-line' : 'ri-whatsapp-line') }}"></i></span><div><strong>{{ a.username ? '@'~a.username : a.name }}</strong><div class="meta-account-meta">{{ include('@MauticMeta/Shared/channel.html.twig', {channel:a.type.value}) }}<small>{{ a.connection.name }}</small></div></div></div><div class="meta-account-status">{{ include('@MauticMeta/Shared/status.html.twig', {status:a.status}) }}</div><a class="btn btn-default" href="{{ path('mautic_meta_asset_edit',{assetId:a.id}) }}">{{ 'mautic.meta.ui.manage_e6c8ac'|trans }}</a></div>{% else %}<div class="meta-pad">{{ 'mautic.meta.ui.add_your_first_connection_to_get_started_b8bd39'|trans }}</div>{% endfor %}</div>
<details class="meta-box meta-pad"><summary>{{ 'mautic.meta.ui.diagnostics_and_general_information_b7a104'|trans }}</summary><p>{{ 'mautic.meta.ui.unfiltered_totals_ec02cc'|trans }} {{ identityCount }} {{ 'mautic.meta.ui.identities_4b30f0'|trans }} {{ eventCount }} {{ 'mautic.meta.ui.events_d80f87'|trans }} {{ webhookFailures }} {{ 'mautic.meta.ui.failed_events_45bde2'|trans }}</p><p>{{ 'mautic.meta.ui.queue_processing_7e6aed'|trans }} <code>php bin/console mautic:meta:queue:process --limit=100</code> {{ 'mautic.meta.ui.every_minute_b16fe0'|trans }}</p><small>{{ 'mautic.meta.ui.this_dashboard_does_not_check_whether_the_scheduled_process_is_ru_285f14'|trans }}</small></details>{% endblock %}
