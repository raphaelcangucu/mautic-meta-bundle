{% extends '@MauticMeta/Shared/layout.html.twig' %}{% block headerTitle %}Configurar conexão Meta{% endblock %}{% block metaBody %}<div class="meta-head"><div><h2>{{ connection is defined ? connection.name : 'Nova conexão Meta' }}</h2><p>Acesso compartilhado pelas contas vinculadas.</p></div><a class="btn btn-default" data-meta-back href="{{ path('mautic_meta_connections') }}">Voltar</a></div><div class="meta-box meta-pad meta-form">{{ form_start(form) }}{{ form_errors(form) }}<div class="meta-fields">{{ form_row(form.name) }}{{ form_row(form.app_id) }}</div><h3>Credenciais</h3><p>Armazenadas com criptografia do Mautic. Ao editar, deixe em branco para manter a credencial atual.</p>{{ form_row(form.app_secret) }}{{ form_row(form.access_token) }}{{ form_row(form.verify_token) }}<details><summary>Configurações avançadas</summary>{{ form_row(form.graph_version) }}{{ form_row(form.consent_source_url) }}{{ form_row(form.consent_source_secret) }}{{ form_row(form.webhook_adapters_json) }}</details><button class="btn btn-primary" name="submit" value="1">Salvar conexão</button>{{ form_end(form) }}</div>{% endblock %}
