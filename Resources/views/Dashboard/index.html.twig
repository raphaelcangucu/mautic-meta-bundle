{% extends '@MauticMeta/Shared/layout.html.twig' %}{% block headerTitle %}Visão geral Meta{% endblock %}{% block metaBody %}<div class="meta-head"><div><h2>Seus canais, em um só lugar</h2><p>Conexões, mensagens e pontos de atenção.</p></div><a class="btn btn-default" href="{{ path('mautic_meta_connections') }}">Gerenciar contas →</a></div>
<form method="get" class="meta-filters"><label>Conta<select class="form-control" name="asset"><option value="">Todas</option>{% for a in allAssets %}<option value="{{ a.id }}" {{ app.request.query.get('asset') == a.id ? 'selected' : '' }}>{{ a.name }}</option>{% endfor %}</select></label><label>Período de criação<select class="form-control" name="period">{% for value,label in {all:'Todo o histórico','7':'Últimos 7 dias','30':'Últimos 30 dias'} %}<option value="{{ value }}" {{ app.request.query.get('period','all') == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><button class="btn btn-primary">Filtrar</button><a class="btn btn-default" href="{{ path('mautic_meta_dashboard') }}">Limpar filtros</a></form>
{% set opFilters = app.request.query.get('asset') ? {asset:app.request.query.get('asset')} : {} %}{% if app.request.query.get('period') in ['7','30'] %}{% set opFilters = opFilters|merge({from:('now'|date_modify('-'~app.request.query.get('period')~' days'))|date('Y-m-d')}) %}{% endif %}
<div class="meta-metrics"><div class="meta-metric">Mensagens<strong>{{ messageCount }}</strong><small>No período e conta selecionados</small></div><a class="meta-metric" href="{{ path('mautic_meta_operations',opFilters|merge({tab:'jobs',status:'queued'})) }}">Fila pendente / nova tentativa<strong>{{ queuePending }}</strong><small>Operações criadas no período</small></a><a class="meta-metric" href="{{ path('mautic_meta_operations',opFilters|merge({tab:'jobs',status:'failed'})) }}">Falhas registradas<strong>{{ queueFailed }}</strong><small>Histórico filtrado · revisar causas</small></a></div>
{% if queueFailed %}<div class="meta-notice"><strong>Há falhas no histórico selecionado.</strong> Um erro antigo não representa necessariamente a situação atual do canal. <a href="{{ path('mautic_meta_operations',opFilters|merge({tab:'jobs',status:'failed'})) }}">Revisar falhas →</a></div>{% endif %}
<div class="meta-box"><div class="meta-boxhead"><strong>Contas conectadas</strong><small>Cadastro completo · {{ connectionCount }} conexões · {{ assetCount }} contas e ativos</small></div>{% for a in allAssets|slice(0,5) %}<div class="meta-row meta-account-row"><div class="meta-person"><span class="meta-avatar"><i class="{{ a.type.value == 'instagram_account' ? 'ri-instagram-line' : (a.type.value == 'facebook_page' ? 'ri-facebook-circle-line' : 'ri-whatsapp-line') }}"></i></span><div><strong>{{ a.username ? '@'~a.username : a.name }}</strong><div class="meta-account-meta">{{ include('@MauticMeta/Shared/channel.html.twig', {channel:a.type.value}) }}<small>{{ a.connection.name }}</small></div></div></div><div class="meta-account-status">{{ include('@MauticMeta/Shared/status.html.twig', {status:a.status}) }}</div><a class="btn btn-default" href="{{ path('mautic_meta_asset_edit',{assetId:a.id}) }}">Gerenciar</a></div>{% else %}<div class="meta-pad">Adicione sua primeira conexão para começar.</div>{% endfor %}</div>
<details class="meta-box meta-pad"><summary>Diagnóstico e informações gerais</summary><p>Totais sem filtros: {{ identityCount }} identidades · {{ eventCount }} eventos · {{ webhookFailures }} eventos com falha.</p><p>Processamento da fila: <code>php bin/console mautic:meta:queue:process --limit=100</code> a cada minuto.</p><small>Este painel não verifica se o processo agendado está ativo.</small></details>{% endblock %}
