{% extends '@MauticMeta/Shared/layout.html.twig' %}{% block headerTitle %}{{ asset is defined ? 'Gerenciar conta' : 'Adicionar conta' }}{% endblock %}
{% block metaBody %}<div class="meta-head"><div><h2>{{ asset is defined ? asset.name : 'Adicionar conta' }}</h2><p>{{ connection.name }}</p></div><a class="btn btn-default" data-meta-back href="{{ path('mautic_meta_connections') }}">Voltar às contas</a></div>
{{ form_start(form, {attr:{class:'meta-form', 'data-meta-asset':''}}) }}{{ form_errors(form) }}<div class="meta-split"><div class="meta-box meta-pad"><h3>Dados da conta</h3>{{ form_row(form.name) }}{{ form_row(form.type) }}<div data-asset-only="instagram_account">{{ form_row(form.username) }}</div><div data-asset-only="whatsapp_phone_number">{{ form_row(form.phone_number) }}</div>{{ form_row(form.contact_match_field) }}{{ form_row(form.is_default) }}<details {{ asset is not defined ? 'open' : '' }}><summary>Identificação técnica</summary>{{ form_row(form.external_id) }}</details></div><div class="meta-box meta-pad"><h3>Limites de envio</h3><p>Limites configurados no conector. As regras e janelas da Meta continuam aplicáveis.</p>{{ form_row(form.daily_send_limit) }}{{ form_row(form.hourly_send_limit) }}{{ form_row(form.recipient_daily_limit) }}{{ form_row(form.recipient_cooldown_seconds) }}</div></div><div class="meta-box meta-pad" data-asset-only="whatsapp_phone_number"><h3>Telefone e consentimento WhatsApp</h3><div class="meta-fields">{{ form_row(form.default_region) }}{{ form_row(form.trusted_import_default_region) }}</div>{{ form_row(form.trusted_import_convert_legacy_br_mobile) }}{{ form_row(form.require_opt_in) }}</div><div class="meta-actions"><button class="btn btn-primary" name="submit" value="1">Salvar alterações</button><a class="btn btn-default" data-meta-back href="{{ path('mautic_meta_connections') }}">Cancelar</a></div>{{ form_end(form) }}
{% if asset is defined %}<details><summary>Remover conta</summary><form method="post" action="{{ path('mautic_meta_asset_delete',{assetId:asset.id}) }}" onsubmit="return confirm('Excluir esta conta e seu histórico de mensagens?');"><input type="hidden" name="_token" value="{{ csrf_token('meta_asset_delete_'~asset.id) }}"><button class="btn btn-danger">Excluir conta</button></form></details>{% endif %}{% endblock %}
