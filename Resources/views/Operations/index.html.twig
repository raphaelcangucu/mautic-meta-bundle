{% extends '@MauticMeta/Shared/layout.html.twig' %}
{% block mauticContent %}meta{% endblock %}
{% block headerTitle %}Operações Meta{% endblock %}
{% block metaBody %}
<div class="meta-head"><div><h2>Operações</h2><p>Envios, eventos e resultados. Aceitação pela Meta não significa entrega.</p></div></div>
<nav class="meta-nav" aria-label="Tipo de operação">{% for key,label in {jobs:'Fila de envio',events:'Eventos recebidos',messages:'Mensagens',deliveries:'Integrações externas'} %}<a class="{{ tab == key ? 'selected' : '' }}" href="{{ path('mautic_meta_operations',listQuery|merge({tab:key})) }}">{{ label }}</a>{% endfor %}</nav>
<form class="meta-filters" method="get"><input type="hidden" name="tab" value="{{ tab }}"><label>Situação<select name="status" class="form-control"><option value="">Todas</option>{% for s in ['queued','pending','retry','failed','completed','cancelled','received','processed','accepted','delivered','read'] %}<option value="{{ s }}" {{ app.request.query.get('status') == s ? 'selected' : '' }}>{{ {queued:'Pendente ou nova tentativa',pending:'Pendente',retry:'Nova tentativa',failed:'Falha',completed:'Concluído',cancelled:'Cancelado',received:'Recebido',processed:'Processado',accepted:'Aceito pela Meta',delivered:'Entregue',read:'Lido'}[s] }}</option>{% endfor %}</select></label>
{% if tab in ['jobs','messages'] %}<label>Conta<select name="asset" class="form-control"><option value="">Todas</option>{% for a in allAssets %}<option value="{{ a.id }}" {{ app.request.query.get('asset') == a.id ? 'selected' : '' }}>{{ a.name }}</option>{% endfor %}</select></label><label>Canal<select name="channel" class="form-control"><option value="">Todos</option>{% for c in ['whatsapp','instagram','facebook'] %}<option value="{{ c }}" {{ app.request.query.get('channel') == c ? 'selected' : '' }}>{{ c|title }}</option>{% endfor %}</select></label><label>Operação<input class="form-control" name="operation" value="{{ app.request.query.get('operation') }}" placeholder="Ex.: whatsapp_text"></label>{% endif %}
<label>Desde<input class="form-control" type="date" name="from" value="{{ app.request.query.get('from') }}"></label><label>Até<input class="form-control" type="date" name="to" value="{{ app.request.query.get('to') }}"></label>{{ include('@MauticMeta/Shared/limit.html.twig') }}</form>{{ include('@MauticMeta/Shared/filter_state.html.twig') }}
<div>
{% if tab == 'deliveries' %}<div class="panel panel-default"><div class="panel-heading"><strong>Integrações externas</strong> <span class="text-muted">Resultados filtrados</span></div><div class="table-responsive"><table class="table table-hover meta-operations-table"><thead><tr><th>ID</th><th>Data</th><th>Adapter</th><th>Event</th><th>Situação</th><th>Tentativas</th><th>Detalhes</th><th></th></tr></thead><tbody>
{% for delivery in listing.items %}<tr><td>{{ delivery.id }}</td><td>{{ delivery.dateAdded|date('d/m/Y H:i') }}</td><td>{{ delivery.adapterName }}</td><td>{{ delivery.eventName }}</td><td>{{ include('@MauticMeta/Shared/status.html.twig', {status:delivery.status}) }}</td><td>{{ delivery.attempts }}/{{ delivery.maxAttempts }}</td><td><small>{{ include('@MauticMeta/Shared/error.html.twig', {error:delivery.lastError}) }}</small></td><td>{% if delivery.status == 'failed' %}<form method="post" action="{{ path('mautic_meta_adapter_retry', {deliveryId: delivery.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('meta_adapter_retry_' ~ delivery.id) }}"><button class="btn btn-primary btn-xs">Revisar nova tentativa</button></form>{% endif %}</td></tr>
{% else %}<tr><td colspan="8" class="text-muted text-center">Nenhuma entrega externa encontrada.</td></tr>{% endfor %}</tbody></table></div></div>{{ include('@MauticMeta/Shared/pagination.html.twig') }}{% endif %}
{% if tab == 'jobs' %}<div class="panel panel-default"><div class="panel-heading"><strong>Fila de envio</strong> <span class="text-muted">Resultados filtrados</span></div><div class="table-responsive"><table class="table table-hover meta-operations-table"><thead><tr><th>ID</th><th>Data</th><th>Conta</th><th>Operação</th><th>Situação</th><th>Tentativas</th><th>Detalhes</th><th></th></tr></thead><tbody>
{% for job in listing.items %}<tr><td>{{ job.id }}</td><td>{{ job.dateAdded|date('d/m/Y H:i') }}</td><td>{{ job.asset.name }}<div class="meta-cell-secondary">{{ include('@MauticMeta/Shared/channel.html.twig', {channel:job.asset.type.value}) }}</div></td><td>{{ {facebook_direct_message:'Mensagem Messenger',facebook_public_reply:'Resposta pública Facebook',instagram_direct_message:'Mensagem Instagram',instagram_private_reply:'Resposta privada Instagram',whatsapp_text:'Texto WhatsApp',whatsapp_template:'Modelo WhatsApp'}[job.operation]|default(job.operation) }}</td><td>{{ include('@MauticMeta/Shared/status.html.twig', {status:job.status}) }}</td><td>{{ job.attempts }}/{{ job.maxAttempts }}</td><td><small>{{ include('@MauticMeta/Shared/error.html.twig', {error:job.lastError}) }}</small></td><td>
{% if job.status in ['failed', 'cancelled'] %}<form onsubmit="return confirm('Revisou a causa da falha e confirmou que a mensagem não foi entregue? Reenfileirar esta operação?');" class="d-inline" method="post" action="{{ path('mautic_meta_job_retry', {jobId: job.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('meta_job_retry_' ~ job.id) }}"><button class="btn btn-primary btn-xs">Revisar nova tentativa</button></form>{% endif %}
{% if job.status in ['pending', 'retry'] %}<form class="d-inline" method="post" action="{{ path('mautic_meta_job_cancel', {jobId: job.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('meta_job_cancel_' ~ job.id) }}"><button class="btn btn-warning btn-xs">Cancelar</button></form>{% endif %}</td></tr>
{% else %}<tr><td colspan="8" class="text-muted text-center">Nenhum envio encontrado.</td></tr>{% endfor %}</tbody></table></div></div>{{ include('@MauticMeta/Shared/pagination.html.twig') }}{% endif %}

{% if tab == 'events' %}<div class="panel panel-default"><div class="panel-heading"><strong>Eventos recebidos</strong> <span class="text-muted">Resultados filtrados</span></div><div class="table-responsive"><table class="table table-hover meta-operations-table"><thead><tr><th>ID</th><th>Recebido em</th><th>Conexão</th><th>Origem</th><th>Situação</th><th>Tentativas</th><th>Detalhes</th><th></th></tr></thead><tbody>
{% for event in listing.items %}<tr><td>{{ event.id }}</td><td>{{ event.receivedAt|date('d/m/Y H:i') }}</td><td>{{ event.connection.name }}</td><td>{{ include('@MauticMeta/Shared/channel.html.twig', {channel:event.objectType}) }}</td><td>{{ include('@MauticMeta/Shared/status.html.twig', {status:event.status}) }}</td><td>{{ event.attempts }}</td><td><small>{{ include('@MauticMeta/Shared/error.html.twig', {error:event.lastError}) }}</small></td><td>{% if event.status == 'failed' %}<form method="post" action="{{ path('mautic_meta_webhook_replay', {eventId: event.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('meta_webhook_replay_' ~ event.id) }}"><button class="btn btn-primary btn-xs">Reprocessar</button></form>{% endif %}</td></tr>
{% else %}<tr><td colspan="8" class="text-muted text-center">Nenhum evento encontrado.</td></tr>{% endfor %}</tbody></table></div></div>{{ include('@MauticMeta/Shared/pagination.html.twig') }}{% endif %}

{% if tab == 'messages' %}<div class="panel panel-default"><div class="panel-heading"><strong>Histórico de mensagens</strong> <span class="text-muted">Resultados filtrados</span></div><div class="table-responsive"><table class="table table-hover meta-operations-table"><thead><tr><th>ID</th><th>Data</th><th>Canal</th><th>Direção</th><th>Conta</th><th>Destinatário</th><th>Tipo</th><th>Situação</th><th>Detalhes</th></tr></thead><tbody>
{% for message in listing.items %}<tr><td>{{ message.id }}</td><td>{{ message.dateAdded|date('d/m/Y H:i') }}</td><td>{{ include('@MauticMeta/Shared/channel.html.twig', {channel:message.channel}) }}</td><td><span class="meta-direction"><i class="{{ message.direction == 'inbound' ? 'ri-arrow-left-down-line' : 'ri-arrow-right-up-line' }}" aria-hidden="true"></i>{{ message.direction == 'inbound' ? 'Recebida' : 'Enviada' }}</span></td><td>{{ message.asset.name }}</td><td class="meta-identifier">{{ message.recipient }}</td><td>{{ include('@MauticMeta/Shared/message_type.html.twig', {type:message.messageType}) }}</td><td>{{ include('@MauticMeta/Shared/status.html.twig', {status:message.status}) }}</td><td><small>{{ include('@MauticMeta/Shared/error.html.twig', {error:message.error}) }}</small></td></tr>
{% else %}<tr><td colspan="9" class="text-muted text-center">Nenhuma mensagem encontrada.</td></tr>{% endfor %}</tbody></table></div></div>{{ include('@MauticMeta/Shared/pagination.html.twig') }}{% endif %}
</div>
{% endblock %}
