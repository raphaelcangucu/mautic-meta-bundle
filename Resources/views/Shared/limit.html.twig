<label>Por página<select name="limit" class="form-control">{% for size in [25,50,100] %}<option value="{{ size }}" {{ listing.limit == size ? 'selected' : '' }}>{{ size }}</option>{% endfor %}</select></label>
<button class="btn btn-primary" type="submit">Filtrar</button><a class="btn btn-default" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route') == 'mautic_meta_operations' ? {tab:app.request.query.get('tab','jobs')} : {}) }}">Limpar filtros</a>
