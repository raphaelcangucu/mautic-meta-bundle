{% extends '@MauticCore/Default/content.html.twig' %}
{% block mauticContent %}meta{% endblock %}
{% block headerTitle %}{{ connection is defined ? 'Edit Meta connection' : 'mautic.meta.connection.new'|trans }}{% endblock %}
{% block content %}
<div class="panel panel-default ma-md"><div class="panel-body">
    <p class="alert alert-info">Credentials are encrypted with the Mautic secret key. Use a Meta System User token in production.</p>
    {{ form_start(form) }}{{ form_widget(form) }}<button type="submit" name="submit" value="1" class="btn btn-primary">{{ 'mautic.core.form.save'|trans }}</button>{{ form_end(form) }}
</div></div>
{% endblock %}
