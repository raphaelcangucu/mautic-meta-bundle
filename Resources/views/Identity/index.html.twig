{% extends '@MauticMeta/Shared/layout.html.twig' %}
{% block mauticContent %}meta{% endblock %}
{% block headerTitle %}{{ 'mautic.meta.ui.identities_and_contacts_8b891f'|trans }}{% endblock %}
{% block metaBody %}
<div class="meta-head"><div><h2>{{ 'mautic.meta.ui.identities_and_contacts_8b891f'|trans }}</h2><p>{{ 'mautic.meta.ui.channel_profiles_and_their_crm_links_ca79f1'|trans }}</p></div></div>
<details class="meta-box meta-pad" {{ syncPreview ? 'open' : '' }}><summary>{{ 'mautic.meta.ui.synchronize_contacts_analysis_execution_and_history_84991e'|trans }}</summary><div class="panel panel-default ma-md"><div class="panel-heading"><h3 class="panel-title">{{ 'mautic.meta.ui.synchronize_opted_in_contacts_27e1ab'|trans }}</h3></div><div class="panel-body">
    <p>{{ 'mautic.meta.ui.analysis_is_required_and_read_only_choose_explicit_evidence_or_at_55b7cc'|trans }}</p>
    <form method="post" action="{{ path('mautic_meta_consent_sync_preview') }}" class="row">
        <input type="hidden" name="_token" value="{{ csrf_token('meta_consent_sync_preview') }}">
        <div class="col-md-3"><label>{{ 'mautic.meta.ui.whatsapp_asset_fa6d00'|trans }}</label><select name="asset_id" class="form-control" required>{% for asset in whatsappAssets %}<option value="{{ asset.id }}">{{ asset.name }} — {{ asset.phoneNumber }}</option>{% endfor %}</select></div>
        <div class="col-md-3"><label>{{ 'mautic.meta.ui.source_d8ecad'|trans }}</label><select name="source_mode" class="form-control"><option value="mautic_api_waitlist">{{ 'mautic.meta.ui.waitlist_contacts_received_through_the_mautic_api_3be8c5'|trans }}</option><option value="explicit_consent_fields">{{ 'mautic.meta.ui.explicit_whatsapp_consent_fields_addeca'|trans }}</option></select></div>
        <div class="col-md-2"><label>{{ 'mautic.meta.ui.stage_or_segment_ff00fa'|trans }}</label><input name="stage" class="form-control" value="Waitlist"></div>
        <div class="col-md-2"><label>{{ 'mautic.meta.ui.explicit_source_version_4334ad'|trans }}</label><input name="source" class="form-control" value="lp_football"><input name="consent_version" class="form-control" value="football_weekly_report_v1"></div>
        <div class="col-md-2"><label>{{ 'mautic.meta.ui.batch_size_04768e'|trans }}</label><input type="number" min="1" max="500" name="batch_size" class="form-control" value="100" required></div>
        <div class="col-md-1"><label>&nbsp;</label><button class="btn btn-primary" type="submit">{{ 'mautic.meta.ui.analyze_contacts_a899d7'|trans }}</button></div>
    </form>
    {% if syncPreview %}
        <hr><h4>{{ 'mautic.meta.ui.ready_to_confirm_asset_a23a31'|trans }} {{ syncPreview.asset.name }} ({{ syncPreview.asset.phone }})</h4>
        <div class="table-responsive"><table class="table table-bordered"><tbody>
        {% for key, value in syncPreview.counts %}<tr><th>{{ key|replace({'_': ' '})|title }}</th><td>{{ value }}</td></tr>{% endfor %}
        </tbody></table></div>
        {% if syncPreview.rejections is not empty %}<details><summary>{{ 'mautic.meta.ui.view_rejected_eba5f4'|trans }}{{ syncPreview.rejections|length }})</summary><pre>{{ syncPreview.rejections|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>{% endif %}
        <form method="post" action="{{ path('mautic_meta_consent_sync_start') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('meta_consent_sync_start') }}"><input type="hidden" name="asset_id" value="{{ syncPreview.asset.id }}"><input type="hidden" name="idempotency_key" value="ui-{{ syncPreview.asset.id }}-{{ 'now'|date('U') }}">
            {% if syncPreview.sourceMode|default('') == 'mautic_api_waitlist' %}<div class="checkbox"><label><input type="checkbox" name="trusted_waitlist_attestation" value="1" required> {{ 'mautic.meta.ui.i_confirm_that_the_selected_contacts_received_through_the_api_and_d21059'|trans }}</label></div>{% endif %}
            <button class="btn btn-success" type="submit">{{ 'mautic.meta.ui.confirm_synchronization_6dbd6c'|trans }}</button>
        </form>
    {% endif %}
</div></div>
<div class="panel panel-default ma-md"><div class="panel-heading"><h3 class="panel-title">{{ 'mautic.meta.ui.synchronization_runs_96c925'|trans }}</h3></div><div class="panel-body"><div class="table-responsive"><table class="table table-hover">
    <thead><tr><th>ID</th><th>{{ 'mautic.meta.ui.status_2d3abf'|trans }}</th><th>{{ 'mautic.meta.ui.asset_8263fd'|trans }}</th><th>{{ 'mautic.meta.ui.progress_4f236f'|trans }}</th><th>{{ 'mautic.meta.ui.operator_7a16ea'|trans }}</th><th>{{ 'mautic.meta.ui.date_e5e429'|trans }}</th><th></th></tr></thead><tbody>
    {% for run in syncRuns %}<tr><td>{{ run.id }}</td><td>{{ run.status|replace({'_': ' '})|title }}</td><td>{{ run.asset.name }}</td><td>{{ run.counts.analyzed|default(0) }} {{ 'mautic.meta.ui.analyzed_ab961d'|trans }} {{ run.counts.eligible|default(0) }} {{ 'mautic.meta.ui.eligible_1f02f4'|trans }} {{ run.counts.rejected|default(0) }} {{ 'mautic.meta.ui.rejected_888b8d'|trans }}</td><td>{{ run.operator ? run.operator.name : ('mautic.meta.ui.system_mcp_440462'|trans) }}</td><td>{{ run.dateAdded|date('mautic.meta.ui.date_time_format'|trans) }}</td><td><a class="btn btn-default btn-sm" href="{{ path('mautic_meta_consent_sync_rejections', {runId: run.id}) }}">{{ 'mautic.meta.ui.rejected_e95515'|trans }}</a>{% if run.status in ['waiting','ready_to_confirm','syncing','failed'] %}<form style="display:inline" method="post" action="{{ path('mautic_meta_consent_sync_cancel', {runId: run.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('meta_consent_sync_cancel_' ~ run.id) }}"><button class="btn btn-danger btn-sm">{{ 'mautic.meta.ui.cancel_c111e0'|trans }}</button></form>{% endif %}</td></tr>
    {% else %}<tr><td colspan="7">{{ 'mautic.meta.ui.no_synchronization_runs_yet_70e3d5'|trans }}</td></tr>{% endfor %}
    </tbody></table></div>
</div></div>
</details><div class="panel panel-default ma-md"><div class="panel-body">
    <p>{{ 'mautic.meta.ui.link_profiles_to_mautic_contacts_and_track_consent_by_channel_afea7d'|trans }}</p>
    <form method="get" action="{{ path('mautic_meta_identities') }}" class="meta-filters">
        <div class="col-md-4"><label>{{ 'mautic.meta.ui.search_a62405'|trans }}</label><input type="search" name="search" value="{{ identityFilters.search }}" class="form-control" placeholder="{{ 'mautic.meta.ui.name_email_phone_meta_id_or_asset_b15ccd'|trans|e('html_attr') }}"></div>
        <div class="col-md-2"><label>{{ 'mautic.meta.ui.channel_61f21e'|trans }}</label><select name="channel" class="form-control"><option value="">{{ 'mautic.meta.ui.all_a4114a'|trans }}</option><option value="whatsapp"{% if identityFilters.channel == 'whatsapp' %} selected{% endif %}>WhatsApp</option><option value="facebook"{% if identityFilters.channel == 'facebook' %} selected{% endif %}>Facebook</option><option value="instagram"{% if identityFilters.channel == 'instagram' %} selected{% endif %}>Instagram</option></select></div>
        <div class="col-md-2"><label>{{ 'mautic.meta.ui.asset_8263fd'|trans }}</label><select name="asset" class="form-control"><option value="">{{ 'mautic.meta.ui.all_a4114a'|trans }}</option>{% for asset in allAssets %}<option value="{{ asset.id }}"{% if identityFilters.asset == asset.id %} selected{% endif %}>{{ asset.name }}</option>{% endfor %}</select></div>
        <div class="col-md-2"><label>{{ 'mautic.meta.ui.consent_c29f64'|trans }}</label><select name="consent" class="form-control"><option value="">{{ 'mautic.meta.ui.all_a4114a'|trans }}</option><option value="opted_in"{% if identityFilters.consent == 'opted_in' %} selected{% endif %}>{{ 'mautic.meta.ui.consent_recorded_14b700'|trans }}</option><option value="opted_out"{% if identityFilters.consent == 'opted_out' %} selected{% endif %}>{{ 'mautic.meta.ui.opted_out_ecbc77'|trans }}</option><option value="unknown"{% if identityFilters.consent == 'unknown' %} selected{% endif %}>{{ 'mautic.meta.ui.not_provided_0cd27e'|trans }}</option></select></div>
        <div><label>{{ 'mautic.meta.ui.link_ccc6cf'|trans }}<select class="form-control" name="linked"><option value="">{{ 'mautic.meta.ui.all_a4114a'|trans }}</option><option value="yes" {{ app.request.query.get('linked') == 'yes' ? 'selected' : '' }}>{{ 'mautic.meta.ui.linked_dfab36'|trans }}</option><option value="no" {{ app.request.query.get('linked') == 'no' ? 'selected' : '' }}>{{ 'mautic.meta.ui.not_linked_0ce391'|trans }}</option></select></label></div><div><label>{{ 'mautic.meta.ui.per_page_9620ad'|trans }}<select class="form-control" name="limit">{% for size in [25,50,100] %}<option {{ identityLimit == size ? 'selected' : '' }}>{{ size }}</option>{% endfor %}</select></label></div><div><label>&nbsp;</label><div><button class="btn btn-primary" type="submit"><i class="ri-search-line"></i> {{ 'mautic.meta.ui.filter_d878f8'|trans }}</button> <a class="btn btn-default" href="{{ path('mautic_meta_identities') }}">{{ 'mautic.meta.ui.clear_765fbe'|trans }}</a></div></div>
    </form>
    {{ include('@MauticMeta/Shared/filter_state.html.twig') }}
    <form id="meta-identities-remove-batch" method="post" action="{{ path('mautic_meta_identity_remove_batch') }}" onsubmit="return confirm({{ ('mautic.meta.ui.remove_the_selected_identities_consent_history_will_be_preserved_67253c'|trans)|json_encode|e('html_attr') }});"><input type="hidden" name="_token" value="{{ csrf_token('meta_identity_remove_batch') }}"><button class="btn btn-danger btn-sm mb-sm" type="submit"><i class="ri-delete-bin-line"></i> {{ 'mautic.meta.ui.remove_selected_b6ae7e'|trans }}</button></form>
    <div class="table-responsive"><table class="table table-hover">
        <thead><tr><th><input type="checkbox" onclick="document.querySelectorAll('.meta-identity-check').forEach((item) => item.checked = this.checked)"></th><th>{{ 'mautic.meta.ui.account_channel_cb5d6d'|trans }}</th><th>{{ 'mautic.meta.ui.social_profile_a82f3a'|trans }}</th><th>{{ 'mautic.meta.ui.mautic_contact_90ee6e'|trans }}</th><th>{{ 'mautic.meta.ui.consent_c29f64'|trans }}</th><th>{{ 'mautic.meta.ui.last_activity_c83c08'|trans }}</th><th></th></tr></thead>
        <tbody>
        {% for identity in identities %}
            {% set formId = 'meta-identity-' ~ identity.id %}
            <tr>
                <td><input class="meta-identity-check" form="meta-identities-remove-batch" type="checkbox" name="ids[]" value="{{ identity.id }}"></td>
                <td><form id="{{ formId }}" method="post" action="{{ path('mautic_meta_identity_update', {identityId: identity.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('meta_identity_' ~ identity.id) }}"></form>{{ identity.asset.name }}<div class="meta-cell-secondary">{{ include('@MauticMeta/Shared/channel.html.twig', {channel:identity.asset.type.value}) }}</div></td>
                <td>{{ identity.username ?: identity.externalId }}</td>
                <td><select form="{{ formId }}" class="form-control chosen" name="contact_id" data-chosen-lookup="lead:contactList" data-model="filter" data-chosen-placeholder="{{ 'mautic.meta.ui.type_to_search_for_a_contact_88d0b8'|trans|e('html_attr') }}" data-allow-clear="true">
                    <option value=""></option>
                    {% if identity.contact %}<option value="{{ identity.contact.id }}" selected>{{ identity.contact.primaryIdentifier == 'mautic.lead.lead.anonymous' ? ('mautic.meta.ui.unnamed_contact_666b99'|trans) : identity.contact.primaryIdentifier }} (#{{ identity.contact.id }})</option>{% endif %}
                </select></td>
                <td><select form="{{ formId }}" class="form-control" name="consent_status">
                    {% for value, label in {'unknown': ('mautic.meta.ui.not_provided_0cd27e'|trans), 'opted_in': ('mautic.meta.ui.consent_recorded_14b700'|trans), 'opted_out': ('mautic.meta.ui.opted_out_ecbc77'|trans)} %}<option value="{{ value }}"{% if identity.consentStatus.value == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
                </select></td>
                <td>{{ identity.lastInteractionAt ? identity.lastInteractionAt|date('mautic.meta.ui.date_time_format'|trans) : '—' }}</td>
                <td><button form="{{ formId }}" class="btn btn-primary btn-sm" type="submit">{{ 'mautic.meta.ui.save_93bf2d'|trans }}</button> <form class="d-inline" method="post" action="{{ path('mautic_meta_identity_remove', {identityId: identity.id}) }}" onsubmit="return confirm({{ ('mautic.meta.ui.remove_this_meta_identity_consent_history_will_be_preserved_06d45f'|trans)|json_encode|e('html_attr') }});"><input type="hidden" name="_token" value="{{ csrf_token('meta_identity_remove_' ~ identity.id) }}"><button class="btn btn-danger btn-sm" type="submit" title="{{ 'mautic.meta.ui.remove_4bd4ea'|trans|e('html_attr') }}"><i class="ri-delete-bin-line"></i></button></form></td>
            </tr>
        {% else %}<tr><td colspan="7">{{ 'mautic.meta.identities.empty'|trans }}</td></tr>{% endfor %}
        </tbody>
    </table></div>
{{ include('@MauticMeta/Shared/pagination.html.twig') }}
</div></div>
{% endblock %}
