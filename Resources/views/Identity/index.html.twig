{% extends '@MauticCore/Default/content.html.twig' %}
{% block mauticContent %}meta{% endblock %}
{% block headerTitle %}{{ 'mautic.meta.identities'|trans }}{% endblock %}
{% block content %}
<div class="panel panel-default ma-md"><div class="panel-heading"><h3 class="panel-title">Sincronizar contatos consentidos</h3></div><div class="panel-body">
    <p>A análise é obrigatória e somente leitura. Escolha evidência explícita ou os contatos Waitlist atestados da API confiável. Nenhuma modalidade envia mensagens.</p>
    <form method="post" action="{{ path('mautic_meta_consent_sync_preview') }}" class="row">
        <input type="hidden" name="_token" value="{{ csrf_token('meta_consent_sync_preview') }}">
        <div class="col-md-3"><label>Ativo WhatsApp</label><select name="asset_id" class="form-control" required>{% for asset in whatsappAssets %}<option value="{{ asset.id }}">{{ asset.name }} — {{ asset.phoneNumber }}</option>{% endfor %}</select></div>
        <div class="col-md-3"><label>Fonte</label><select name="source_mode" class="form-control"><option value="mautic_api_waitlist">Contatos Waitlist recebidos pela API do Mautic</option><option value="explicit_consent_fields">Campos explícitos whatsapp_consent_*</option></select></div>
        <div class="col-md-2"><label>Etapa ou segmento</label><input name="stage" class="form-control" value="Waitlist"></div>
        <div class="col-md-2"><label>Origem/versão explícita</label><input name="source" class="form-control" value="lp_football"><input name="consent_version" class="form-control" value="football_weekly_report_v1"></div>
        <div class="col-md-2"><label>Tamanho do lote</label><input type="number" min="1" max="500" name="batch_size" class="form-control" value="100" required></div>
        <div class="col-md-1"><label>&nbsp;</label><button class="btn btn-primary" type="submit">Analisar contatos</button></div>
    </form>
    {% if syncPreview %}
        <hr><h4>Pronto para confirmar — ativo {{ syncPreview.asset.name }} ({{ syncPreview.asset.phone }})</h4>
        <div class="table-responsive"><table class="table table-bordered"><tbody>
        {% for key, value in syncPreview.counts %}<tr><th>{{ key|replace({'_': ' '})|title }}</th><td>{{ value }}</td></tr>{% endfor %}
        </tbody></table></div>
        {% if syncPreview.rejections is not empty %}<details><summary>Consultar rejeitados ({{ syncPreview.rejections|length }})</summary><pre>{{ syncPreview.rejections|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details>{% endif %}
        <form method="post" action="{{ path('mautic_meta_consent_sync_start') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('meta_consent_sync_start') }}"><input type="hidden" name="asset_id" value="{{ syncPreview.asset.id }}"><input type="hidden" name="idempotency_key" value="ui-{{ syncPreview.asset.id }}-{{ 'now'|date('U') }}">
            {% if syncPreview.sourceMode|default('') == 'mautic_api_waitlist' %}<div class="checkbox"><label><input type="checkbox" name="trusted_waitlist_attestation" value="1" required> Confirmo que os contatos selecionados, recebidos pela API e classificados como Waitlist, possuem consentimento válido para WhatsApp.</label></div>{% endif %}
            <button class="btn btn-success" type="submit">Confirmar sincronização</button>
        </form>
    {% endif %}
</div></div>
<div class="panel panel-default ma-md"><div class="panel-heading"><h3 class="panel-title">Execuções de sincronização</h3></div><div class="panel-body"><div class="table-responsive"><table class="table table-hover">
    <thead><tr><th>ID</th><th>Status</th><th>Ativo</th><th>Progresso</th><th>Operador</th><th>Data</th><th></th></tr></thead><tbody>
    {% for run in syncRuns %}<tr><td>{{ run.id }}</td><td>{{ run.status|replace({'_': ' '})|title }}</td><td>{{ run.asset.name }}</td><td>{{ run.counts.analyzed|default(0) }} analisados; {{ run.counts.eligible|default(0) }} elegíveis; {{ run.counts.rejected|default(0) }} rejeitados</td><td>{{ run.operator ? run.operator.name : 'Sistema/MCP' }}</td><td>{{ run.dateAdded|date('Y-m-d H:i') }}</td><td><a class="btn btn-default btn-sm" href="{{ path('mautic_meta_consent_sync_rejections', {runId: run.id}) }}">Rejeitados</a>{% if run.status in ['waiting','ready_to_confirm','syncing','failed'] %}<form style="display:inline" method="post" action="{{ path('mautic_meta_consent_sync_cancel', {runId: run.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('meta_consent_sync_cancel_' ~ run.id) }}"><button class="btn btn-danger btn-sm">Cancelar</button></form>{% endif %}</td></tr>
    {% else %}<tr><td colspan="7">Nenhuma sincronização executada.</td></tr>{% endfor %}
    </tbody></table></div>
</div></div>
<div class="panel panel-default ma-md"><div class="panel-body">
    <p>{{ 'mautic.meta.identities.help'|trans }}</p>
    <form method="get" action="{{ path('mautic_meta_identities') }}" class="row mb-md">
        <div class="col-md-5"><label>Buscar</label><input type="search" name="search" value="{{ identityFilters.search }}" class="form-control" placeholder="Nome, e-mail, telefone, Meta ID ou ativo"></div>
        <div class="col-md-3"><label>Ativo</label><select name="asset" class="form-control"><option value="">Todos</option>{% for asset in allAssets %}<option value="{{ asset.id }}"{% if identityFilters.asset == asset.id %} selected{% endif %}>{{ asset.name }}</option>{% endfor %}</select></div>
        <div class="col-md-2"><label>{{ 'mautic.meta.consent'|trans }}</label><select name="consent" class="form-control"><option value="">Todos</option><option value="opted_in"{% if identityFilters.consent == 'opted_in' %} selected{% endif %}>Opted in</option><option value="opted_out"{% if identityFilters.consent == 'opted_out' %} selected{% endif %}>Opted out</option><option value="unknown"{% if identityFilters.consent == 'unknown' %} selected{% endif %}>Unknown</option></select></div>
        <div class="col-md-2"><label>&nbsp;</label><div><button class="btn btn-primary" type="submit"><i class="ri-search-line"></i> Filtrar</button> <a class="btn btn-default" href="{{ path('mautic_meta_identities') }}">Limpar</a></div></div>
    </form>
    <div class="table-responsive"><table class="table table-hover">
        <thead><tr><th>{{ 'mautic.core.channel'|trans }}</th><th>Meta ID / phone</th><th>{{ 'mautic.lead.lead'|trans }}</th><th>{{ 'mautic.meta.consent'|trans }}</th><th>{{ 'mautic.meta.last_activity'|trans }}</th><th></th></tr></thead>
        <tbody>
        {% for identity in identities %}
            {% set formId = 'meta-identity-' ~ identity.id %}
            <tr>
                <td><form id="{{ formId }}" method="post" action="{{ path('mautic_meta_identity_update', {identityId: identity.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('meta_identity_' ~ identity.id) }}"></form>{{ identity.asset.name }}</td>
                <td>{{ identity.username ?: identity.externalId }}</td>
                <td><select form="{{ formId }}" class="form-control chosen" name="contact_id" data-chosen-lookup="lead:contactList" data-model="filter" data-chosen-placeholder="Digite para buscar um contato" data-allow-clear="true">
                    <option value=""></option>
                    {% if identity.contact %}<option value="{{ identity.contact.id }}" selected>{{ identity.contact.primaryIdentifier }} (#{{ identity.contact.id }})</option>{% endif %}
                </select></td>
                <td><select form="{{ formId }}" class="form-control" name="consent_status">
                    {% for value, label in {'unknown': 'Unknown', 'opted_in': 'Opted in', 'opted_out': 'Opted out'} %}<option value="{{ value }}"{% if identity.consentStatus.value == value %} selected{% endif %}>{{ label }}</option>{% endfor %}
                </select></td>
                <td>{{ identity.lastInteractionAt ? identity.lastInteractionAt|date('Y-m-d H:i') : '—' }}</td>
                <td><button form="{{ formId }}" class="btn btn-primary btn-sm" type="submit">{{ 'mautic.core.form.save'|trans }}</button></td>
            </tr>
        {% else %}<tr><td colspan="6">{{ 'mautic.meta.identities.empty'|trans }}</td></tr>{% endfor %}
        </tbody>
    </table></div>
    <div class="panel-footer">{{ include('@MauticCore/Helper/pagination.html.twig', {
        totalItems: identityTotal, page: identityPage, limit: identityLimit,
        menuLinkId: 'mautic_meta_identities', baseUrl: path('mautic_meta_identities'), sessionVar: 'metaIdentities',
        target: '.page-wrapper', queryString: '&search=' ~ identityFilters.search|url_encode ~ '&asset=' ~ (identityFilters.asset ?: '') ~ '&consent=' ~ (identityFilters.consent ?: '')
    }) }}</div>
</div></div>
{% endblock %}
