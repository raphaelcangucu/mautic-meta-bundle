{% extends '@MauticMeta/Shared/layout.html.twig' %}
{% block headerTitle %}Tech Provider{% endblock %}
{% block metaBody %}
{{ includeStylesheet('plugins/MauticMetaBundle/Assets/css/tech-provider.css?v=20260914-1') }}
{% set providerCount = 0 %}{% set customerCount = 0 %}
{% for connection in connections %}{% if connection.customer %}{% set customerCount = customerCount + 1 %}{% else %}{% set providerCount = providerCount + 1 %}{% endif %}{% endfor %}
<div class="tp-page">
  <header class="tp-hero"><div><span class="tp-eyebrow">META · WHATSAPP BUSINESS</span><h1>Conectar empresas ao WhatsApp</h1><p>Configure o aplicativo, autorize empresas e acompanhe cada número sem perder de vista as conexões existentes.</p></div><a class="btn btn-default" href="{{ path('mautic_meta_connections') }}">Todas as conexões</a></header>
  <div class="tp-stats" aria-label="Resumo"><div><span>Aplicativos provedores</span><strong>{{ providerCount }}</strong></div><div><span>Empresas associadas</span><strong>{{ customerCount }}</strong></div><div><span>Números cadastrados</span><strong>{{ phones|length }}</strong><small>Inclui conexões anteriores</small></div></div>
  <div class="tp-steps"><div><b>1</b><span><strong>Configurar aplicativo</strong><small>ID do Embedded Signup</small></span></div><div><b>2</b><span><strong>Autorizar empresa</strong><small>Seleção oficial na Meta</small></span></div><div><b>3</b><span><strong>Validar número</strong><small>Diagnóstico na ficha do ativo</small></span></div></div>

  <div class="tp-heading"><span class="tp-eyebrow">CONFIGURAÇÃO</span><h2>Aplicativos provedores</h2></div>
  {% for connection in connections %}{% if not connection.customer %}
    {% set configured = connection.settings.embedded_signup_config_id|default('') %}
    <section class="tp-card"><div class="tp-card-head"><div class="tp-identity"><span class="tp-icon">M</span><div><h3>{{ connection.name }}</h3><small>Aplicativo Meta {{ connection.appId }}</small></div></div><span class="tp-badge {{ connection.status == 'active' ? 'tp-good' : '' }}">{{ connection.status }}</span></div><div class="tp-card-body"><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('meta_provider') }}"><input type="hidden" name="action" value="configure"><input type="hidden" name="provider" value="{{ connection.id }}"><label for="tp-config-{{ connection.id }}">ID da configuração do Embedded Signup</label><div class="tp-inline"><input id="tp-config-{{ connection.id }}" required class="form-control" name="config_id" inputmode="numeric" pattern="[0-9]{5,32}" value="{{ configured }}" placeholder="Encontrado em Facebook Login for Business"><button class="btn btn-default">Salvar configuração</button></div></form><div class="tp-card-foot"><span class="tp-dot {{ configured ? 'tp-dot-good' : '' }}">{{ configured ? 'Configuração salva' : 'Configuração pendente' }}</span><a href="{{ path('mautic_meta_provider', {provider:connection.id}) }}" class="btn btn-primary">Autorizar empresa</a></div></div></section>
  {% endif %}{% endfor %}

  {% if nonce %}<section class="tp-card tp-signup"><div class="tp-card-body"><span class="tp-eyebrow">NOVA AUTORIZAÇÃO</span><h2>Conectar uma empresa pelo Mautic</h2><p>A empresa escolhe o próprio WABA e número na janela oficial da Meta. Nenhuma conexão antiga é migrada automaticamente.</p><form id="meta-provider-signup" method="post" data-app="{{ provider.appId }}" data-version="{{ provider.graphVersion }}" data-config="{{ provider.settings.embedded_signup_config_id }}"><input type="hidden" name="_token" value="{{ csrf_token('meta_provider') }}"><input type="hidden" name="action" value="connect"><input type="hidden" name="nonce" value="{{ nonce }}"><input type="hidden" name="code"><input type="hidden" name="waba_id"><input type="hidden" name="phone_id"><label for="tp-name">Nome da empresa no Mautic</label><div class="tp-inline"><input id="tp-name" class="form-control" name="name" required maxlength="191" placeholder="Nome que aparecerá na lista"><button type="button" id="meta-provider-launch" class="btn btn-primary" disabled>Conectar com a Meta</button></div><p id="meta-provider-result" role="status">Carregando autorização oficial…</p></form></div></section><script src="{{ asset('plugins/MauticMetaBundle/Assets/js/tech-provider.js') }}"></script>{% endif %}

  <div class="tp-heading"><span class="tp-eyebrow">EMPRESAS</span><h2>Empresas associadas</h2><p>Cada empresa tem sua própria autorização e seus próprios ativos.</p></div>
  {% for connection in connections %}{% if connection.customer %}
    <section class="tp-card"><div class="tp-card-head"><div class="tp-identity"><span class="tp-icon tp-customer-icon">E</span><div><h3>{{ connection.name }}</h3><small>Empresa Meta {{ connection.businessId }}</small></div></div><span class="tp-badge {{ connection.status == 'active' ? 'tp-good' : '' }}">{{ connection.status }}</span></div><div class="tp-company-body"><div><strong>Números associados</strong>{% set companyPhones = 0 %}{% for phone in phones %}{% if phone.connection.id == connection.id %}{% set companyPhones = companyPhones + 1 %}<div class="tp-company-phone"><span>{{ phone.phoneNumber|default(phone.name) }}</span><a href="{{ path('mautic_meta_asset_edit',{assetId:phone.id}) }}">Abrir diagnóstico →</a></div>{% endif %}{% endfor %}{% if companyPhones == 0 %}<p>Nenhum número cadastrado nesta empresa.</p>{% endif %}</div><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('meta_provider') }}"><input type="hidden" name="action" value="pause"><input type="hidden" name="provider" value="{{ connection.id }}"><button class="btn btn-default" {% if connection.status == 'paused' %}disabled{% endif %}>{{ connection.status == 'paused' ? 'Envios pausados' : 'Pausar envios' }}</button></form></div></section>
  {% endif %}{% endfor %}
  {% if customerCount == 0 %}<div class="tp-empty">Nenhuma empresa associada ainda. Configure o aplicativo acima e inicie a autorização.</div>{% endif %}

  <details class="tp-legacy"><summary>Conexões anteriores e números sem empresa associada <span>{{ phones|length }} números no total</span></summary><div class="tp-legacy-body"><p>Para ver diagnóstico e ações de um número WhatsApp, abra a ficha dele. Esta lista não migra nem remove ativos.</p>{% for phone in phones %}{% if not phone.connection.customer %}<div class="tp-legacy-row"><div><strong>{{ phone.name }}</strong><small>{{ phone.connection.name }} · {{ phone.phoneNumber|default('Número não informado') }}</small></div><a class="btn btn-default" href="{{ path('mautic_meta_asset_edit',{assetId:phone.id}) }}">Abrir diagnóstico</a></div>{% endif %}{% endfor %}</div></details>
  <aside class="tp-note"><strong>Conexão não é entrega.</strong> Restrições por país e pagamento são verificadas separadamente. Um status <em>accepted</em> não confirma <em>delivered</em>; acompanhe os envios em <a href="{{ path('mautic_meta_operations') }}">Operações</a>.</aside>
</div>
{% endblock %}
